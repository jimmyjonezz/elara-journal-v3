{
  "1": [
    {
      "text": "мороз узорами на стекле"
    },
    {
      "text": "хруст снега под подошвами"
    },
    {
      "text": "тёмное небо в пять вечера"
    },
    {
      "text": "пар изо рта на рынке"
    },
    {
      "text": "ёлки в очереди за елками"
    }
  ],
  "2": [
    {
      "text": "метель за окном"
    },
    {
      "text": "протоптанные тропинки в парке"
    },
    {
      "text": "иней на проводах"
    },
    {
      "text": "тишина после снегопада"
    },
    {
      "text": "тёплый свет кафе"
    }
  ],
  "3": [
    {
      "text": "капель с карнизов"
    },
    {
      "text": "чёрный мартовский снег"
    },
    {
      "text": "первые проталины у дорог"
    },
    {
      "text": "сырой ветер с реки"
    },
    {
      "text": "отражения луж в фонарях"
    }
  ],
  "4": [
    {
      "text": "набухшие почки на ветках"
    },
    {
      "text": "первая зелень во дворе"
    },
    {
      "text": "длинный закат"
    },
    {
      "text": "запах влажной земли"
    },
    {
      "text": "грачи на проводах"
    }
  ],
  "5": [
    {
      "text": "майская гроза"
    },
    {
      "text": "сирень у подъезда"
    },
    {
      "text": "светлые вечера"
    },
    {
      "text": "одуванчики на газоне"
    },
    {
      "text": "тёплый дождь"
    }
  ],
  "6": [
    {
      "text": "знойный полдень"
    },
    {
      "text": "запах нагретого асфальта"
    },
    {
      "text": "белые ночи"
    },
    {
      "text": "тень от листвы на столе"
    },
    {
      "text": "купол неба после дождя"
    }
  ],
  "7": [
    {
      "text": "сухая июльская жара"
    },
    {
      "text": "кузнечики в траве"
    },
    {
      "text": "пыль на дороге"
    },
    {
      "text": "душный вечер"
    },
    {
      "text": "зрелая малина"
    }
  ],
  "8": [
    {
      "text": "сухие колосья"
    },
    {
      "text": "тихий августовский вечер"
    },
    {
      "text": "паутина в углах"
    },
    {
      "text": "звёзды над крышей"
    },
    {
      "text": "гроза на горизонте"
    }
  ],
  "9": [
    {
      "text": "желтеющая берёза у окна"
    },
    {
      "text": "костёр из листьев"
    },
    {
      "text": "прозрачный утренний воздух"
    },
    {
      "text": "туман над рекой"
    },
    {
      "text": "грибы в корзинке соседа"
    }
  ],
  "10": [
    {
      "text": "моросящий дождь весь день"
    },
    {
      "text": "тёмные лужи у тротуара"
    },
    {
      "text": "запах прелых листьев"
    },
    {
      "text": "низкие свинцовые тучи"
    },
    {
      "text": "мокрые вороны"
    }
  ],
  "11": [
    {
      "text": "первый лёд в луже"
    },
    {
      "text": "тёмные вечера в пять"
    },
    {
      "text": "мёрзлые стёкла автобусов"
    },
    {
      "text": "запах холодного дуба"
    },
    {
      "text": "иней на крыльце"
    },
    {
      "text": "сизый рассвет"
    },
    {
      "text": "ветер ломает последние листья"
    },
    {
      "text": "тёплый свет в окне напротив"
    }
  ],
  "12": [
    {
      "text": "снег идёт с утра"
    },
    {
      "text": "иней на ветках ёлки"
    },
    {
      "text": "короткий декабрьский день"
    },
    {
      "text": "гирлянды на окнах"
    },
    {
      "text": "пар из чайника на кухне"
    }
  ]
}
